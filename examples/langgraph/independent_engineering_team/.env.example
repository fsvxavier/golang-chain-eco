# Copy to .env. With no key at all the team runs offline with a scripted model.

# --- provider keys (set the ones you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_API_KEY=   # for google_genai:... specs

# --- one model per agent: AGENT_MODEL_<ROLE>=provider:model ---
# Roles: MANAGER PO ARCHITECT LEADER JUNIOR MID SENIOR SPECIALIST QA KNOWLEDGE
# Anthropic names may be written short: opus_5_5 -> claude-opus-5-5
# Unset roles use AGENT_MODEL, then per-role defaults for the key you set
# (Anthropic: opus for PO/architect, sonnet for manager/leader/senior/specialist, haiku for the rest).
# AGENT_MODEL=anthropic:sonnet_5_5
# AGENT_MODEL_PO=anthropic:opus_5_5
# AGENT_MODEL_ARCHITECT=anthropic:opus_5_5
# AGENT_MODEL_JUNIOR=anthropic:haiku_5_5
# AGENT_MODEL_MID=anthropic:sonnet_5_5
# AGENT_MODEL_SENIOR=openai:gpt-4o
# AGENT_MODEL_QA=anthropic:haiku_5_5
# AGENT_MODEL_KNOWLEDGE=anthropic:haiku_5_5   # model behind RAG/CAG/KAG answers

# --- knowledge ---
# KNOWLEDGE_EMBEDDINGS=openai:text-embedding-3-small   # default: offline hashing embeddings

# --- operations ---
HUB_LEASE_TTL=15s        # a worker silent for longer loses its job to another worker
# MANAGER_API_KEY=       # require x-api-key on the manager's Agent Server API

# --- task status notifications (manager) ---
# Every move of a task (received, in_specification, ... completed) is announced.
# NOTIFY=console,slack,email,chat     # default: console
# NOTIFY_STATUSES=review_rejected,qa_rejected,completed   # limits slack/email/chat; console shows all
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# CHAT_WEBHOOK_URL=https://chat.example.com/hooks/...     # any webhook that takes {"text": "...", "event": {...}}
# SMTP_ADDR=smtp.example.com:587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=team@example.com
# MAIL_TO=lead@example.com,po@example.com

# --- MCP bridge (cmd/bridge): chats and consoles reach the team, ciam and knowledge ---
# MANAGER_URL=http://localhost:8080
# MANAGER_API_KEY=
# HUB_URL=http://localhost:8000
# BRIDGE_CIAM_CMD=/abs/path/to/ciam mcp                 # project context tools (ciam_*); optional
# BRIDGE_KNOWLEDGE_CMD=/abs/path/to/knowledge mcp --dir /abs/path/.knowledge   # RAG/CAG/KAG (knowledge_*); needs `knowledge index` first
